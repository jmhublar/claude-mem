# Claude-Mem Environment Variables
# Copy this file to .env and fill in your values
# Generate tokens with: openssl rand -hex 32

# ===========================================
# Authentication
# ===========================================

# Shared secret for worker ↔ backend authentication
CLAUDE_MEM_WORKER_AUTH_TOKEN=

# Token for remote API access (MCP servers, hooks, external clients)
CLAUDE_MEM_REMOTE_TOKEN=

# ===========================================
# AI Provider
# ===========================================

# AI provider to use: mistral, gemini, openrouter, openai, anthropic
CLAUDE_MEM_AI_PROVIDER=openai

# API Keys (only need the one matching your provider)
CLAUDE_MEM_MISTRAL_API_KEY=
CLAUDE_MEM_GEMINI_API_KEY=
CLAUDE_MEM_OPENROUTER_API_KEY=
CLAUDE_MEM_OPENAI_API_KEY=
CLAUDE_MEM_ANTHROPIC_API_KEY=

# ===========================================
# Data
# ===========================================

# Host directory for SQLite database and Qdrant storage
# Default: ~/.claude-mem (created by setup.sh)
CLAUDE_MEM_DATA_DIR=

# Host port exposed by the backend container (default: 38888)
# Set to 37777 to replace vanilla claude-mem's port
CLAUDE_MEM_HOST_PORT=38888

# ===========================================
# Logging
# ===========================================

# Log level: debug, info, warn, error
CLAUDE_MEM_LOG_LEVEL=info
